import "../assets/fonts/NotoSans.ttf";
import "../assets/fonts/NotoSans-Italic.ttf";
import "../assets/fonts/EBGaramond.ttf";
import "../assets/fonts/EBGaramond-Italic.ttf";
import "../assets/fonts/Cinzel.ttf";

export global AppTheme {
    // --- Colors ---

    // Backgrounds
    in property <color> bg-deepest: #1a120b;        // window background

    // Text
    in property <color> text-light: #f3e6c8;       // on dark panels

    // --- Typography ---
    in property <string> font-body: "Noto Sans";      
    in property <string> font-display: "EB Garamond"; 
    in property <string> font-brand: "Cinzel";        
}
